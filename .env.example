# VANTAGE environment variables. Copy to .env and uncomment what you want to change.
# Everything runs on your machine by default: no API keys and no cloud services needed.

# Trace store: a SQLite file by default. PostgreSQL needs the postgres extra.
# DATABASE_URL=sqlite:///data/observability.db

# --- The traced model -------------------------------------------------------------
# local: an open model on this machine (pip install -e ".[local]"); claude: the Anthropic API.
# LLM_PROVIDER=local

# Hugging Face models, downloaded once on first use (about 3.5 GB in total).
# LOCAL_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
# LOCAL_NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli

# Where they run: auto (CUDA, then Apple MPS, then CPU), cuda, mps or cpu.
# LOCAL_DEVICE=auto
# LOCAL_MAX_NEW_TOKENS=512

# --- Optional: Claude (LLM_PROVIDER=claude, pip install -e ".[claude]") -------------
# With Claude, a judge also grades the coherence and relevance of every traced response.
# ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-opus-5-5
# JUDGE_MODEL=claude-haiku-5-5
